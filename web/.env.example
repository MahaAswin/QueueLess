# ==============================================================================
# QueueLess Web (Frontend) Environment Variables
# ==============================================================================
# For Local Development:
# Leave empty to use the Vite local proxy (defined in vite.config.ts -> localhost:8080)
# or set to http://localhost:8080
#
# For Production Deployment on Vercel:
# Set VITE_API_URL in Vercel Project Settings > Environment Variables:
# Example: VITE_API_URL=https://queueless-backend.onrender.com
# (Do not add a trailing slash; the application will sanitize if present)
VITE_API_URL=
