# ==============================================================================
# QueueLess Production & Local Environment Variables Template
# ==============================================================================
# Copy this file or individual service .env.example files to .env for local testing.
# For Cloud Deployments: Configure these in Render (Backend) and Vercel (Frontend).

# ------------------------------------------------------------------------------
# 1. BACKEND DEPLOYMENT (Render / Spring Boot)
# ------------------------------------------------------------------------------
# Server Port (Render injects PORT automatically; defaults to 8080 locally)
PORT=8080

# Neon PostgreSQL Database Configuration
# Local Example:
# DB_URL=jdbc:postgresql://localhost:5432/queueless
# Neon Cloud Example (Ensure jdbc: prefix and sslmode=require):
DB_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
# Optional: Set to true only for local SQL debugging (defaults to false in production)
SHOW_SQL=false

# JWT Authentication (Generate a secure 256-bit secret via: openssl rand -hex 32)
JWT_SECRET=generate_a_secure_random_256_bit_secret_key_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration (Comma-separated allowed origins, e.g. your Vercel domain)
# Example: https://queueless.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:8080

# Protected Default Administrator Email
DEFAULT_ADMIN_EMAIL=admin@queueless.com

# QR & OTP Pickup Expiration Timers
QR_EXPIRATION_MINUTES=30
OTP_EXPIRATION_MINUTES=3
OTP_MAX_FAILED_ATTEMPTS=5

# Trust & Suspension Thresholds
USER_SUSPENSION_THRESHOLD=3
SHOP_SUSPENSION_THRESHOLD=3

# ------------------------------------------------------------------------------
# 2. FRONTEND DEPLOYMENT (Vercel / React + Vite)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings > Environment Variables:
# Points to your Render backend web service URL (without trailing slash)
VITE_API_URL=https://your-queueless-backend.onrender.com
