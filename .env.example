# QueueLess Backend Environment Variables Template
# Copy this file to .env and set real environment values for production deployments.

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/queueless
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# QR Verification Expiration (Minutes)
QR_EXPIRATION_MINUTES=30

# Trust System Violation Thresholds
USER_SUSPENSION_THRESHOLD=3
SHOP_SUSPENSION_THRESHOLD=3
